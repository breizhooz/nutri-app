SERVICE_USER_URL=http://service-user:8000
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_RECIPES=recipes

# Inter-service : récupération du résumé nutrition d'un user auprès de service-profile.
# SERVICE_PROFILE_TOKEN doit être identique à celui de service-profile.
SERVICE_PROFILE_URL=http://service-profile:8000
SERVICE_PROFILE_TOKEN=your-inter-service-token

# Scoring nutritionnel (proximité macros) dans la recherche personnalisée.
# L'index recettes porte les macros ; nécessite un /reindex après mise à jour du mapping.
APPLY_NUTRITION_SCORING=True

# Unsplash (recherche d'images de recettes). ACCESS_KEY suffit pour la recherche.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_API_URL=https://api.unsplash.com

# Spoonacular (récupération quotidienne de recettes mises en cache).
# Clé : https://spoonacular.com/food-api/console#Profile . Vide → fetch désactivé.
SPOONACULAR_API_KEY=
SPOONACULAR_API_URL=https://api.spoonacular.com
SPOONACULAR_DAILY_COUNT=3
SPOONACULAR_FETCH_HOUR=4