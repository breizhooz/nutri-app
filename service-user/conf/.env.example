DATABASE_URL=postgresql://user:password@postgres-user:5432/nutriplanner_user
DEBUG=True

JWT_SECRET=XXXX
JWT_ALGORITHM=XXXX
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=XX
JWT_REFRESH_TOKEN_EXPIRE_DAYS=XX

#OAUTH2
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
OAUTH_REDIRECT_BASE_URL=https://api.nutri-app.com
# Front-end base URL the OAuth callback redirects to (with tokens in the query).
FRONTEND_URL=https://localhost:5173

#MFA
MFA_TOTP_ENCRYPTION_KEY=generate-with-cryptography-fernet-generate-key
# Titre affiché dans l'app d'authentification pour les entrées TOTP (issuer du QR).
MFA_ISSUER=Rost.r
# Logo incrusté au centre du QR 2FA. Vide = logo de marque bundlé (Rost.r).
MFA_QR_LOGO_PATH=

#TOKEN NOTIF
NOTIFICATION_SERVICE_URL=http://service-notification:8006
NOTIFICATION_SERVICE_TOKEN=change-me-internal-token