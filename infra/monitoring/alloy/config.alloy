// Grafana Alloy — collecte des logs des conteneurs nutriplanner-* vers Loki.
// Remplace Promtail (déprécié). Lecture via l'API Docker (socket monté en lecture).
//
// Labels Loki (faible cardinalité) : container, service, level.
// trace_id → métadonnée structurée (pas un label : un label par requête créerait
// un flux par trace et saturerait max_streams_per_user). Requête :
//   {service=~".+"} | trace_id="<id>"
// La ligne est conservée telle quelle (JSON structlog complet).

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "containers" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/nutriplanner-.*"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.+)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["service"]
    regex         = "^$"
    target_label  = "service"
    replacement   = "unknown"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  relabel_rules    = discovery.relabel.containers.rules
  refresh_interval = "5s"
  forward_to       = [loki.process.json.receiver]
}

loki.process "json" {
  forward_to = [loki.write.local.receiver]

  // Les lignes non JSON (uvicorn, postgres…) passent telles quelles.
  stage.json {
    expressions = {
      level    = "level",
      trace_id = "trace_id",
    }
  }

  stage.labels {
    values = { level = "" }
  }

  stage.structured_metadata {
    values = { trace_id = "" }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
