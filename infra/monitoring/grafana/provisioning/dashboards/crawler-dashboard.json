{
  "title": "Rost.r — Crawler",
  "uid": "nutriplanner-crawler",
  "tags": ["crawler", "celery", "instagram"],
  "timezone": "Europe/Paris",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "schemaVersion": 39,
  "panels": [

    {
      "id": 1,
      "title": "Taux de requêtes HTTP (toutes routes)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (handler, method) (rate(http_requests_total{instance=\"service-crawler:8000\"}[5m]))",
          "legendFormat": "{{method}} {{handler}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "title": "Codes HTTP (répartition)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "2xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_requests_total{instance=\"service-crawler:8000\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },

    {
      "id": 3,
      "title": "Celery — Tasks reçues (crawler)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum by (level) (count_over_time({service=\"celery-worker-crawler\"} |= \"received\" [5m]))",
          "legendFormat": "tasks reçues",
          "refId": "A"
        },
        {
          "expr": "sum by (level) (count_over_time({service=\"celery-worker-crawler\"} |= \"succeeded\" [5m]))",
          "legendFormat": "tasks terminées",
          "refId": "B"
        },
        {
          "expr": "sum by (level) (count_over_time({service=\"celery-worker-crawler\"} |= \"retry\" [5m]))",
          "legendFormat": "tasks en retry",
          "refId": "C"
        }
      ]
    },

    {
      "id": 4,
      "title": "Celery — Erreurs Instagram",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "count_over_time({service=\"celery-worker-crawler\"} |= \"instagram\" |= \"error\" [5m])",
          "legendFormat": "erreurs instagram",
          "refId": "A"
        },
        {
          "expr": "count_over_time({service=\"celery-worker-crawler\"} |= \"rate limit\" [5m])",
          "legendFormat": "rate limit 429",
          "refId": "B"
        }
      ]
    },

    {
      "id": 5,
      "title": "Logs HTTP — Requêtes récentes",
      "type": "logs",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": true,
        "showTime": true,
        "wrapLogMessage": false
      },
      "targets": [
        {
          "expr": "{service=\"service-crawler\"} | json | method != `` | path != `/metrics` | path != `/health`",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "title": "Logs Worker — Celery tasks",
      "type": "logs",
      "gridPos": { "x": 0, "y": 26, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showTime": true,
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{service=\"celery-worker-crawler\"} |= \"instagram\"",
          "refId": "A"
        }
      ]
    }

  ]
}
