# ── service-user — contrat d'environnement ───────────────────────────────
# GÉNÉRÉ par infra/scripts/gen_env_examples.py depuis app/core/config.py — ne pas éditer.
# Requis = pas de valeur par défaut dans Settings. Les noms marqués [secret]
# vont dans infra/env/secrets/user.secrets.env, le reste dans services/user.env.

# requis (str)
DATABASE_URL=
# optionnel (bool, défaut: False)
#DEBUG=False
# requis (str) [secret]
JWT_SECRET=
# optionnel (str, défaut: 'HS256')
#JWT_ALGORITHM=HS256
# optionnel (int, défaut: 30) [secret]
#JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
# optionnel (int, défaut: 30) [secret]
#JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
# optionnel (str, défaut: '') [secret]
#GOOGLE_CLIENT_ID=
# optionnel (str, défaut: '') [secret]
#GOOGLE_CLIENT_SECRET=
# optionnel (str, défaut: '') [secret]
#FACEBOOK_CLIENT_ID=
# optionnel (str, défaut: '') [secret]
#FACEBOOK_CLIENT_SECRET=
# optionnel (str, défaut: '')
#OAUTH_REDIRECT_BASE_URL=
# optionnel (int, défaut: 60) [secret]
#OAUTH_BOOTSTRAP_TOKEN_EXPIRE_SECONDS=60
# optionnel (str, défaut: 'https://localhost:5173')
#FRONTEND_URL=https://localhost:5173
# optionnel (str, défaut: 'refresh_token')
#REFRESH_COOKIE_NAME=refresh_token
# optionnel (str, défaut: '/api/v1/auth')
#REFRESH_COOKIE_PATH=/api/v1/auth
# optionnel (bool, défaut: True)
#COOKIE_SECURE=True
# optionnel (str, défaut: 'none')
#COOKIE_SAMESITE=none
# optionnel (str | None, défaut: None)
#COOKIE_DOMAIN=
# optionnel (str, défaut: '') [secret]
#MFA_TOTP_ENCRYPTION_KEY=
# optionnel (int, défaut: 5) [secret]
#MFA_TOKEN_EXPIRE_MINUTES=5
# optionnel (int, défaut: 5)
#MFA_EMAIL_CODE_EXPIRE_MINUTES=5
# optionnel (str, défaut: 'NutriPlanner')
#MFA_ISSUER=NutriPlanner
# optionnel (str, défaut: '')
#MFA_QR_LOGO_PATH=
# optionnel (str, défaut: '')
#NOTIFICATION_SERVICE_URL=
# optionnel (str, défaut: '') [secret]
#NOTIFICATION_SERVICE_TOKEN=
# optionnel (int, défaut: 30) [secret]
#PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
# optionnel (str, défaut: 'http://localhost:3000') [secret]
#PASSWORD_RESET_BASE_URL=http://localhost:3000
# optionnel (int, défaut: 5) [secret]
#PASSWORD_HISTORY_COUNT=5
# optionnel (int, défaut: 10)
#LOGIN_RATE_LIMIT_PER_MINUTE=10
# optionnel (int, défaut: 10)
#MFA_VERIFY_RATE_LIMIT_PER_MINUTE=10
