# ── service-nutrition — contrat d'environnement ───────────────────────────────
# GÉNÉRÉ par infra/scripts/gen_env_examples.py depuis app/core/config.py — ne pas éditer.
# Requis = pas de valeur par défaut dans Settings. Les noms marqués [secret]
# vont dans infra/env/secrets/nutrition.secrets.env, le reste dans services/nutrition.env.

# requis (str)
DATABASE_URL=
# optionnel (bool, défaut: False)
#DEBUG=False
# requis (str) [secret]
JWT_SECRET=
# optionnel (str, défaut: 'HS256')
#JWT_ALGORITHM=HS256
# optionnel (str, défaut: 'http://elasticsearch:9200')
#ELASTICSEARCH_URL=http://elasticsearch:9200
# optionnel (str, défaut: 'nutrition_items')
#ELASTICSEARCH_INDEX=nutrition_items
# optionnel (str, défaut: 'redis://redis:6379/0')
#CELERY_BROKER_URL=redis://redis:6379/0
# optionnel (str, défaut: 'redis://redis:6379/1')
#CELERY_RESULT_BACKEND=redis://redis:6379/1
# optionnel (int, défaut: 90)
#MACRO_ERROR_RETENTION_DAYS=90
# optionnel (str, défaut: '') [secret]
#GROQ_API_KEY=
# optionnel (str, défaut: 'llama-3.1-8b-instant')
#GROQ_MODEL=llama-3.1-8b-instant
# optionnel (str, défaut: 'https://world.openfoodfacts.org')
#OFF_BASE_URL=https://world.openfoodfacts.org
# optionnel (str, défaut: 'Rost.r/1.0 (contact@nutriplanner.fr)')
#OFF_USER_AGENT=Rost.r/1.0 (contact@nutriplanner.fr)
# optionnel (str, défaut: 'https://ciqual.anses.fr/cms/sites/default/files/inline-files/2025_11_03.7z')
#CIQUAL_DOWNLOAD_URL=https://ciqual.anses.fr/cms/sites/default/files/inline-files/2025_11_03.7z
# optionnel (str, défaut: '') [secret]
#SERVICE_NUTRITION_TOKEN=
# optionnel (str, défaut: 'http://service-notification:8006')
#SERVICE_NOTIFICATION_URL=http://service-notification:8006
# optionnel (str, défaut: '') [secret]
#SERVICE_NOTIFICATION_TOKEN=
