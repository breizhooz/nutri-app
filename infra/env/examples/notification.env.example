# ── service-notification — contrat d'environnement ───────────────────────────────
# GÉNÉRÉ par infra/scripts/gen_env_examples.py depuis app/core/config.py — ne pas éditer.
# Requis = pas de valeur par défaut dans Settings. Les noms marqués [secret]
# vont dans infra/env/secrets/notification.secrets.env, le reste dans services/notification.env.

# requis (str)
DATABASE_URL=
# optionnel (bool, défaut: False)
#DEBUG=False
# requis (str) [secret]
JWT_SECRET=
# optionnel (str, défaut: 'HS256')
#JWT_ALGORITHM=HS256
# requis (str) [secret]
VAPID_PRIVATE_KEY=
# requis (str) [secret]
VAPID_PUBLIC_KEY=
# optionnel (str, défaut: 'admin@nutriplanner.app')
#VAPID_CLAIMS_EMAIL=admin@nutriplanner.app
# optionnel (str, défaut: '') [secret]
#SERVICE_NOTIFICATION_TOKEN=
# optionnel (str, défaut: 'redis://redis:6379/0')
#CELERY_BROKER_URL=redis://redis:6379/0
# optionnel (str, défaut: 'redis://redis:6379/1')
#CELERY_RESULT_BACKEND=redis://redis:6379/1
# optionnel (int, défaut: 365)
#NOTIFICATION_RETENTION_DAYS=365
# optionnel (str, défaut: '')
#SMTP_HOST=
# optionnel (int, défaut: 587)
#SMTP_PORT=587
# optionnel (str, défaut: '')
#SMTP_USER=
# optionnel (str, défaut: '') [secret]
#SMTP_PASSWORD=
# optionnel (str, défaut: 'noreply@nutri-app.com')
#SMTP_FROM=noreply@nutri-app.com
# optionnel (bool, défaut: True)
#SMTP_USE_TLS=True
