# ── service-crawler — contrat d'environnement ───────────────────────────────
# GÉNÉRÉ par infra/scripts/gen_env_examples.py depuis app/core/config.py — ne pas éditer.
# Requis = pas de valeur par défaut dans Settings. Les noms marqués [secret]
# vont dans infra/env/secrets/crawler.secrets.env, le reste dans services/crawler.env.

# requis (str)
DATABASE_URL=
# optionnel (bool, défaut: False)
#DEBUG=False
# requis (str)
CELERY_BROKER_URL=
# requis (str)
CELERY_RESULT_BACKEND=
# requis (str)
MINIO_ENDPOINT=
# requis (str) [secret]
MINIO_ACCESS_KEY=
# requis (str) [secret]
MINIO_SECRET_KEY=
# requis (str)
MINIO_BUCKET_CRAWLER=
# optionnel (bool, défaut: False)
#MINIO_SECURE=False
# requis (str)
SERVICE_RECIPE_URL=
# optionnel (str, défaut: '') [secret]
#SERVICE_RECIPE_TOKEN=
# requis (str)
SERVICE_NOTIFICATION_URL=
# optionnel (str, défaut: '') [secret]
#SERVICE_NOTIFICATION_TOKEN=
# optionnel (str, défaut: '')
#SERVICE_NUTRITION_URL=
# optionnel (str, défaut: '') [secret]
#SERVICE_NUTRITION_TOKEN=
# optionnel (int, défaut: 200)
#JS_DETECTION_THRESHOLD=200
# requis (str) [secret]
JWT_SECRET=
# optionnel (str, défaut: 'HS256')
#JWT_ALGORITHM=HS256
# optionnel (str, défaut: '') [secret]
#INSTAGRAM_USERNAME=
# optionnel (str, défaut: '') [secret]
#INSTAGRAM_PASSWORD=
# optionnel (str, défaut: '/data/instagram_session')
#INSTAGRAM_SESSION_FILE=/data/instagram_session
# optionnel (int, défaut: 0)
#INSTAGRAM_MAX_POSTS_PER_RUN=0
# optionnel (float, défaut: 2.0)
#INSTAGRAM_PAGE_DELAY_SECONDS=2.0
# optionnel (int, défaut: 20)
#INSTAGRAM_PAGE_SIZE=20
# optionnel (float, défaut: 0.8)
#INSTAGRAM_POST_DELAY_SECONDS=0.8
# optionnel (float, défaut: 0.4)
#INSTAGRAM_JITTER_RATIO=0.4
# optionnel (str, défaut: '') [secret]
#GROQ_API_KEY=
# optionnel (str, défaut: '') [secret]
#GROQ_API_KEYS=
