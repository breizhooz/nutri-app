# ── service-menu — contrat d'environnement ───────────────────────────────
# GÉNÉRÉ par infra/scripts/gen_env_examples.py depuis app/core/config.py — ne pas éditer.
# Requis = pas de valeur par défaut dans Settings. Les noms marqués [secret]
# vont dans infra/env/secrets/menu.secrets.env, le reste dans services/menu.env.

# requis (str)
DATABASE_URL=
# optionnel (bool, défaut: False)
#DEBUG=False
# requis (str)
SERVICE_USER_URL=
# requis (str)
SERVICE_RECIPE_URL=
# optionnel (str, défaut: 'http://service-profile:8000')
#SERVICE_PROFILE_URL=http://service-profile:8000
# optionnel (str, défaut: '') [secret]
#SERVICE_PROFILE_TOKEN=
# optionnel (str, défaut: '') [secret]
#SERVICE_MENU_TOKEN=
# requis (str) [secret]
JWT_SECRET=
# optionnel (str, défaut: 'HS256')
#JWT_ALGORITHM=HS256
