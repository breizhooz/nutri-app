# ── service-profile — contrat d'environnement ───────────────────────────────
# GÉNÉRÉ par infra/scripts/gen_env_examples.py depuis app/core/config.py — ne pas éditer.
# Requis = pas de valeur par défaut dans Settings. Les noms marqués [secret]
# vont dans infra/env/secrets/profile.secrets.env, le reste dans services/profile.env.

# requis (str)
DATABASE_URL=
# optionnel (bool, défaut: False)
#DEBUG=False
# requis (str) [secret]
JWT_SECRET=
# optionnel (str, défaut: 'HS256')
#JWT_ALGORITHM=HS256
# requis (str) [secret]
SERVICE_PROFILE_TOKEN=
# requis (str) [secret]
PROFILE_FIELD_ENCRYPTION_KEY=
