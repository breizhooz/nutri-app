# ── service-recipe — contrat d'environnement ───────────────────────────────
# GÉNÉRÉ par infra/scripts/gen_env_examples.py depuis app/core/config.py — ne pas éditer.
# Requis = pas de valeur par défaut dans Settings. Les noms marqués [secret]
# vont dans infra/env/secrets/recipe.secrets.env, le reste dans services/recipe.env.

# requis (str)
DATABASE_URL=
# optionnel (bool, défaut: False)
#DEBUG=False
# optionnel (str, défaut: 'http://service-user:8000')
#SERVICE_USER_URL=http://service-user:8000
# requis (str)
ELASTICSEARCH_URL=
# requis (str)
ELASTICSEARCH_INDEX_RECIPES=
# requis (str) [secret]
JWT_SECRET=
# optionnel (str, défaut: 'HS256')
#JWT_ALGORITHM=HS256
# optionnel (str, défaut: '') [secret]
#SERVICE_RECIPE_TOKEN=
# optionnel (str, défaut: 'redis://redis:6379/0')
#CELERY_BROKER_URL=redis://redis:6379/0
# optionnel (str, défaut: 'redis://redis:6379/1')
#CELERY_RESULT_BACKEND=redis://redis:6379/1
# optionnel (str, défaut: 'seaweedfs:8333')
#S3_ENDPOINT=seaweedfs:8333
# optionnel (str, défaut: 'user_admin') [secret]
#S3_ACCESS_KEY=user_admin
# optionnel (str, défaut: 'changeme') [secret]
#S3_SECRET_KEY=changeme
# optionnel (str, défaut: 'recipes')
#S3_BUCKET=recipes
# optionnel (str, défaut: 'http://localhost:8333')
#S3_PUBLIC_URL=http://localhost:8333
# optionnel (str, défaut: '')
#SERVICE_NUTRITION_URL=
