# ── service-nutrition — conf non secrète (committée) ──────────────────────
DEBUG=false

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# URLs inter-services (les tokens sont dans secrets/nutrition.secrets.env)
