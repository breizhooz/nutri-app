# ── service-recipe — conf non secrète (committée) ─────────────────────────
DEBUG=True

# URLs inter-services (les tokens sont dans secrets/recipe.secrets.env)
SERVICE_USER_URL=http://service-user:8000
SERVICE_RECIPE_URL=http://service-user:8002
SERVICE_NUTRITION_URL=http://service-nutrition:8000
SERVICE_PROFILE_URL=http://service-profile:8000
SERVICE_NOTIFICATION_URL=http://service-notification:8000

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_RECIPES=recipes

# Stockage objets S3 / SeaweedFS (les clés d'accès sont dans secrets/recipe.secrets.env)
S3_ENDPOINT=seaweedfs:8333
S3_BUCKET=recipes
S3_PUBLIC_URL=http://localhost:8333

# JWT (le secret est dans secrets/recipe.secrets.env)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# APIs externes (les clés sont dans secrets/recipe.secrets.env)
UNSPLASH_API_URL=https://api.unsplash.com
SPOONACULAR_API_URL=https://api.spoonacular.com
SPOONACULAR_DAILY_COUNT=3
SPOONACULAR_FETCH_HOUR=4
