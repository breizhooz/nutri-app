# ── service-notification — conf non secrète (committée) ───────────────────
DEBUG=false

# Web Push (les clés VAPID sont dans secrets/notification.secrets.env)
VAPID_CLAIMS_EMAIL=admin@nutriplanner.app

# SMTP (le mot de passe est dans secrets/notification.secrets.env)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@nutri-app.com
SMTP_FROM=noreply@nutri-app.com
SMTP_USE_TLS=true
