# ── service-crawler — conf non secrète (committée) ────────────────────────
DEBUG=True

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
REDIS_CACHE_URL=redis://redis:6379/2

# MinIO (les clés d'accès sont dans secrets/crawler.secrets.env)
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_CRAWLER=crawler-media
MINIO_SECURE=False

# URLs inter-services (les tokens sont dans secrets/crawler.secrets.env)
SERVICE_RECIPE_URL=http://service-recipe:8000
SERVICE_NOTIFICATION_URL=http://service-notification:8000
SERVICE_NUTRITION_URL=http://service-nutrition:8000

# Détection de pages rendues en JS
JS_DETECTION_THRESHOLD=200

# JWT (le secret est dans secrets/crawler.secrets.env)
JWT_ALGORITHM=HS256

# Instagram — session persistée dans le volume instagram-session
INSTAGRAM_SESSION_FILE=/data/instagram_session

# Groq (la clé API est dans secrets/crawler.secrets.env)
GROQ_MODEL=llama-3.1-8b-instant
