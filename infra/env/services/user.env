# ── service-user — conf non secrète (committée) ──────────────────────────
DEBUG=True

# JWT (le secret est dans secrets/user.secrets.env)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth2 (les client_id/secret sont dans secrets/user.secrets.env)
OAUTH_REDIRECT_BASE_URL=http://localhost:8001
FRONTEND_URL=https://localhost:5173

# MFA
MFA_ISSUER=Rost.r
# Logo incrusté au centre du QR 2FA. Vide = logo de marque bundlé (Rost.r).
MFA_QR_LOGO_PATH=

# Notifications inter-services
NOTIFICATION_SERVICE_URL=http://service-notification:8006
