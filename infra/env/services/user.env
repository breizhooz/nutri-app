# ── service-user — conf non secrète (committée) ──────────────────────────
DEBUG=True

# JWT (le secret est dans secrets/user.secrets.env)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth2 (les client_id/secret sont dans secrets/user.secrets.env)
OAUTH_REDIRECT_BASE_URL=http://localhost:8001
FRONTEND_URL=https://localhost:5173

# MFA
MFA_ISSUER=Rost.r
# Logo incrusté au centre du QR 2FA. Vide = logo de marque bundlé (Rost.r).
MFA_QR_LOGO_PATH=

# Notifications inter-services
NOTIFICATION_SERVICE_URL=http://service-notification:8006

# ── Effacement RGPD (art. 17) — orchestration cross-service via Celery ────
# URLs des services détenteurs de données. Les *_SERVICE_TOKEN correspondants
# (= SERVICE_<X>_TOKEN de chaque service cible) sont dans secrets/user.secrets.env.
PROFILE_SERVICE_URL=http://service-profile:8000
MENU_SERVICE_URL=http://service-menu:8000
NUTRITION_SERVICE_URL=http://service-nutrition:8000
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
