# ──────────────────────────────────────────────────────────────────────────
# PLATEFORME — variables transverses, injectées dans TOUS les services métier.
# Committé : aucun secret ici (les secrets vivent dans secrets/*.secrets.env).
# Précédence env_file : platform.env → services/<svc>.env → secrets (le dernier gagne).
# ──────────────────────────────────────────────────────────────────────────

# Logging
LOG_LEVEL=DEBUG

# ── Observabilité / traces (OTel → Tempo) ─────────────────
# Tempo fait partie du profil `monitoring` (optionnel). Tant qu'il n'est pas
# lancé, l'export des traces échoue en boucle ("Failed to export span batch").
# Par défaut on désactive donc le tracing. Pour collecter les traces, lance la
# stack monitoring ET passe ceci à `false` :
#   OTEL_SDK_DISABLED=false  +  docker compose --profile monitoring up
OTEL_SDK_DISABLED=true
