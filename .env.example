# ── Moteur Postgres unique : superuser (admin + postgres_exporter) ────────
POSTGRES_SUPERUSER=XXXX
POSTGRES_SUPERUSER_PASSWORD=XXXX

POSTGRES_USER_DB=XXXX
POSTGRES_USER_USER=XXXX
POSTGRES_USER_PASSWORD=XXX

POSTGRES_RECIPE_DB=XXXX
POSTGRES_RECIPE_USER=XXXX
POSTGRES_RECIPE_PASSWORD=XXXX

POSTGRES_MENU_DB=XXX
POSTGRES_MENU_USER=XXX
POSTGRES_MENU_PASSWORD=XXX

POSTGRES_CRAWLER_DB=XXXX
POSTGRES_CRAWLER_USER=XXXXX
POSTGRES_CRAWLER_PASSWORD=XXXXX

POSTGRES_NOTIFICATION_DB=XXXX
POSTGRES_NOTIFICATION_USER=XXXX
POSTGRES_NOTIFICATION_PASSWORD=XXXXX

POSTGRES_NUTRITION_DB=XXXX
POSTGRES_NUTRITION_USER=XXXXX
POSTGRES_NUTRITION_PASSWORD=XXXX

POSTGRES_PROFILE_DB=XXXX
POSTGRES_PROFILE_USER=XXXX
POSTGRES_PROFILE_PASSWORD=XXXX

# ── MinIO ─────────────────────────────────────────────────
MINIO_ROOT_USER=XXXX
MINIO_ROOT_PASSWORD=XXXXX

# ── Grafana ───────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=changeme

# ── Celery Flower (SEC-02) ────────────────────────────────
# Auth basique obligatoire de la console Flower, format "user:password".
# À définir impérativement (sinon repli "flower:change-me-in-env" côté compose).
FLOWER_BASIC_AUTH=flower:change-me-in-env

# ── Traefik (prod uniquement) ─────────────────────────────
# TRAEFIK_DASHBOARD_USER=admin
# TRAEFIK_DASHBOARD_PASSWORD_HASH=$$apr1$$...

# ── Observabilité / traces (OTel → Tempo) ─────────────────
# Tempo fait partie du profil `monitoring` (optionnel). Tant qu'il n'est pas
# lancé, l'export des traces échoue en boucle ("Failed to export span batch").
# Par défaut on désactive le tracing. Pour collecter les traces, lance la stack
# monitoring ET passe ceci à `false` :
#   OTEL_SDK_DISABLED=false  +  docker compose --profile monitoring up
OTEL_SDK_DISABLED=true