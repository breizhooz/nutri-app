DATABASE_URL=postgresql+asyncpg://crawler_user:password@postgres-crawler:5432/crawler_db
DEBUG=True
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
S3_ENDPOINT=seaweedfs:8333
S3_ACCESS_KEY=XXXX
S3_SECRET_KEY=XXXX
S3_BUCKET_CRAWLER=crawler-media
S3_SECURE=False
SERVICE_RECIPE_URL=http://service-recipe:8000
SERVICE_NOTIFICATION_URL=http://service-notification:8000
JS_DETECTION_THRESHOLD=200
JWT_SECRET=XXXX
JWT_ALGORITHM=HS256
INSTAGRAM_USERNAME=XXXX
INSTAGRAM_PASSWORD=XXXX
INSTAGRAM_SESSION_FILE=/data/instagram_session
# Anti-blocage (valeurs par défaut, surcharge optionnelle) : plafond/run (0=illimité),
# pause longue toutes les PAGE_SIZE posts, micro-pause par post, jitter ±ratio.
INSTAGRAM_MAX_POSTS_PER_RUN=0
INSTAGRAM_PAGE_DELAY_SECONDS=2.0
INSTAGRAM_PAGE_SIZE=20
INSTAGRAM_POST_DELAY_SECONDS=0.8
INSTAGRAM_JITTER_RATIO=0.4
